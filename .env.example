APP_ENV=development
API_PORT=8000
WEB_PORT=3000

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me-for-local-hs256-verification
SUPABASE_JWT_AUDIENCE=authenticated
DEVICE_HASH_SECRET=replace-me-with-a-random-secret

# Database. Use Supabase PostgreSQL for a connected environment or local Postgres for development.
DATABASE_URL=postgresql+psycopg://goag:goag@localhost:5432/goag

# Frontend/API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGINS=http://localhost:3000

# GOAG test attendance settings
GOAG_TEST_WORKSITE_LAT=0
GOAG_TEST_WORKSITE_LON=0
GOAG_TEST_GEOFENCE_RADIUS_M=150
GOAG_MAX_GPS_ACCURACY_M=100
GOAG_SHIFT_START=09:00
GOAG_SHIFT_END=18:00
GOAG_LATE_GRACE_MINUTES=15
GOAG_TEST_PROXY_DELAY_MS=0

# Shared GOAG Gmail mailbox (leave blank until Google OAuth is configured)
GOAG_GMAIL_CLIENT_ID=
GOAG_GMAIL_CLIENT_SECRET=
GOAG_GMAIL_REDIRECT_URI=
# Optional restriction. Leave blank to use the Google account selected during OAuth.
GOAG_GMAIL_MAILBOX_ADDRESS=
GOAG_GMAIL_TOKEN_ENCRYPTION_KEY=
GOAG_WEB_URL=http://localhost:3000

# Playwright role-matrix test credentials (never commit passwords)
GOAG_TEST_PASSWORD=123456
GOAG_RUN_ROLE_MATRIX=0
GOAG_TEST_MD_EMAIL=
GOAG_TEST_MD_PASSWORD=
GOAG_TEST_PRODUCTION_MANAGER_EMAIL=
GOAG_TEST_STORE_MANAGER_EMAIL=
GOAG_TEST_SALES_MANAGER_EMAIL=
GOAG_TEST_TECHNICIAN_EMAIL=
GOAG_TEST_AFTER_SALES_EMAIL=
# Data-writing Playwright workflow test; keep disabled for normal test runs.
GOAG_E2E_WORKFLOW=0
# Deterministic read-only dashboard failure-state tests; keep disabled for normal runs.
GOAG_E2E_FAILURES=0
